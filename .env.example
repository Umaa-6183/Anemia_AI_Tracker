# ════════════════════════════════════════════════════════
# Anemia AI Tracker — Environment Variables
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked  ← CHANGE THIS
# 3. Never commit .env to version control
# ════════════════════════════════════════════════════════


# ── Application ──────────────────────────────────────────
ENVIRONMENT=development          # development | production
DEBUG=false                      # true enables hot-reload and verbose errors
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR


# ── Security ─────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING    # ← CHANGE THIS


# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=anemia_tracker
POSTGRES_USER=anemia_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD                        # ← CHANGE THIS

# Full SQLAlchemy URL (auto-built by docker-compose from above vars)
# Override manually if using an external DB:
# DATABASE_URL=postgresql://user:password@host:5432/dbname


# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production (replace with your actual domain):
# ALLOWED_ORIGINS=https://your-domain.com


# ── Model ────────────────────────────────────────────────
# Path inside the backend container where the trained model lives
MODEL_PATH=/app/models/saved/hb_cnn_model.h5
MODEL_INPUT_SIZE=128             # Must match training configuration

# IQA thresholds (tunable without retraining)
IQA_BLUR_THRESHOLD=80.0          # Laplacian variance — lower = more permissive
IQA_BRIGHTNESS_LOW=40.0          # Reject frames darker than this (0-255)
IQA_BRIGHTNESS_HIGH=220.0        # Reject frames brighter than this (0-255)


# ── Training data ─────────────────────────────────────────
# Host path mounted into the backend container at /app/data
TRAINING_DATA_DIR=./backend/data


# ── pgAdmin (dev only) ───────────────────────────────────
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin                                         # ← CHANGE THIS


# ── React frontend ───────────────────────────────────────
# Leave empty to use same-origin proxying (recommended with Docker Compose)
REACT_APP_API_URL=
# Set to backend URL for standalone frontend deployments:
# REACT_APP_API_URL=https://api.your-domain.com
